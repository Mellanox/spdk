FROM dockerhub.nvidia.com/openanolis/anolisos:8.6
ARG _UID=6213
ARG _GID=11429
ARG _LOGIN=swx-jenkins
ARG _HOME=/var/home/$_LOGIN
ARG MOFED_VER
ENV LANG=en_US.utf-8
USER root

RUN set -eux; \
    yum upgrade -y rpm; \
    if [ -f /var/lib/rpm/Packages ]; then \
        rm -rf /var/lib/rpmrebuilddb.*; \
        rpmdb --rebuilddb || true; \
        newdb=$(ls -d /var/lib/rpmrebuilddb.* | head -n1); \
        test -f "$newdb/rpmdb.sqlite"; \
        rm -rf /var/lib/rpm/*; \
        mv "$newdb"/* /var/lib/rpm/; \
        rmdir "$newdb"; \
    fi; \
    test -f /var/lib/rpm/rpmdb.sqlite; \
    rpm -qa > /dev/null

RUN yum install -y ca-certificates

RUN yum install -y \
    epel-release

RUN yum install -y \
    sudo \
    git \
    wget \
    vim \
    fakeroot \
    ncurses-devel \
    rpm-build doxygen \
    graphviz \
    numactl-devel \
    libiscsi-devel \
    make \
    gcc \
    CUnit-devel \
    libaio-devel \
    openssl-devel \
    libuuid-devel \
    gcc-c++ \
    python39 \
    meson \
    python3-pip \
    python3-configshell \
    pkgconfig autoconf automake libtool \
    fuse3-devel patchelf

RUN set -eux; \
    echo -e "[mlnx_ofed]\n\
name=Mellanox Technologies \$basearch mlnx_ofed\n\
baseurl=http://nbu-nfs.gtm.nvidia.com/auto/mswg/release/MLNX_OFED/MLNX_OFED_LINUX-${MOFED_VER}/MLNX_OFED_LINUX-${MOFED_VER}-anolis8.6-\$basearch/RPMS/\n\
enabled=1\n\
gpgcheck=0" > /etc/yum.repos.d/mellanox_mlnx_ofed.repo; \
    yum install -y mlnx-ofed-basic-user-only

RUN pip3 install --prefix=/usr/ pyelftools

RUN echo "${_LOGIN} ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers
RUN mkdir -p $_HOME
RUN groupadd -f -g "$_GID" "$_LOGIN"
RUN useradd -u "$_UID" -g "$_GID" -s /bin/bash -m -d ${_HOME} "$_LOGIN"
RUN chown $_LOGIN $_HOME
RUN yum clean all

SHELL ["/bin/bash"]
USER "${_LOGIN}"
ENTRYPOINT [ "/bin/bash", "--login", "--rcfile", "/etc/bashrc", "-c" ]
